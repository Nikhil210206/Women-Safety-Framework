# Copy to .env.local and fill these values.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Local stack (see supabase/README.md): http://127.0.0.1:54321 and the ANON_KEY
# printed by `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastAPI backend, read by the /api/heatmap route. Defaults to this when unset.
BACKEND_URL=http://localhost:8000
